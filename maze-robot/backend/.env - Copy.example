PORT=8080
# Note: the robot WebSocket bridge (firmware <-> backend) shares this same
# port at path /robot; it does not use a separate port.
MONGO_URI=mongodb://localhost:27017/maze_robot
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=8h
JWT_REFRESH_EXPIRES_IN=30d
ROBOT_AUTH_TOKEN=CHANGE_ME_ROBOT_SECRET
CORS_ORIGIN=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=noreply@example.com
SMTP_PASS=changeme
FRONTEND_URL=http://localhost:5173
